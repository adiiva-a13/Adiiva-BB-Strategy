//@version=5
strategy("Break & Bounce Strategy", overlay=true, max_bars_back=500)

// ─── TIMEFRAME GUARD ───────────────────────────────────────────────────────────────
if timeframe.period != "5"
    runtime.error("Break & Bounce trebuie rulat pe timeframe M5!")

// ─── SESIUNEA NY (ora României: 16:30 - 19:00 INCLUSIV) ────────────────────────
// "1630-1905" include bara M5 care se deschide la 19:00 (se închide la 19:05)
ny_session = time(timeframe.period, "1630-1905:23456", "Europe/Bucharest")

// ─── UN SINGUR TRADE PE ZI ───────────────────────────────────────────────────────
var bool traded_today = false
if ta.change(dayofmonth)
    traded_today := false

// ─── DAILY HIGH / LOW ─────────────────────────────────────────────────────────
daily_high = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
daily_low  = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)

plot(daily_high, "Daily HIGH", color=color.blue,  linewidth=1, style=plot.style_line)
plot(daily_low,  "Daily LOW",  color=color.red,   linewidth=1, style=plot.style_line)

// ─── M15 BREAK DETECTION (filtrat la sesiunea NY) ─────────────────────────────
m15_close      = request.security(syminfo.tickerid, "15", close[1], lookahead=barmerge.lookahead_on)
m15_close_prev = request.security(syminfo.tickerid, "15", close[2], lookahead=barmerge.lookahead_on)

bull_break = m15_close > daily_high and m15_close_prev <= daily_high and not na(ny_session)
bear_break = m15_close < daily_low  and m15_close_prev >= daily_low  and not na(ny_session)

var bool bull_break_active = false
var bool bear_break_active = false

if bull_break
    bull_break_active := true
    bear_break_active := false
if bear_break
    bear_break_active := true
    bull_break_active := false

// ─── TREND: closes descrescatoare/crescatoare pe ultimele 3 bare ───────────────────
bearish_trend = close[1] < close[2] and close[2] < close[3]
bullish_trend = close[1] > close[2] and close[2] > close[3]

// ─── CANDLESTICK PATTERNS (M5) ────────────────────────────────────────────────
body       = math.abs(close - open)
upper_wick = high - math.max(close, open)
lower_wick = math.min(close, open) - low

// Hammer: fitil jos lung, corp mic sus, precedat de trend bearish
is_hammer = (lower_wick >= body * 2) and (upper_wick <= body * 0.5) and bearish_trend

// Shooting Star: fitil sus lung, corp mic jos, precedat de trend bullish
is_shooting_star = (upper_wick >= body * 2) and (lower_wick <= body * 0.5) and bullish_trend

// Bullish Engulfing: verde care înghite roșul precedent, precedat de trend bearish
is_bull_engulf = (close > open) and
                 (close[1] < open[1]) and (close > open[1]) and (open < close[1]) and
                 bearish_trend

// Bearish Engulfing: roșu care înghite verdele precedent, precedat de trend bullish
is_bear_engulf = (close < open) and
                 (close[1] > open[1]) and (close < open[1]) and (open > close[1]) and
                 bullish_trend

// ─── RETEST: lumânarea atinge nivelul cu low/high ───────────────────────────────
// Directia bullish/bearish e confirmata de pattern, nu de close vs nivel
in_bull_retest = bull_break_active and (low <= daily_high)
in_bear_retest = bear_break_active and (high >= daily_low)

// ─── ENTRY SIGNALS ────────────────────────────────────────────────────────────
bull_signal = in_bull_retest and (is_hammer or is_bull_engulf)
bear_signal = in_bear_retest and (is_shooting_star or is_bear_engulf)

// ─── EXECUȚIE cu SL sub/peste lumânarea de semnal, TP la RR 1:3 ───────────────────
if bull_signal and not na(ny_session) and not traded_today
    sl_price  = low
    real_risk = close - sl_price
    tp_price  = close + real_risk * 3
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY Exit", "BUY", stop=sl_price, limit=tp_price)
    bull_break_active := false
    traded_today      := true

if bear_signal and not na(ny_session) and not traded_today
    sl_price  = high
    real_risk = sl_price - close
    tp_price  = close - real_risk * 3
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL Exit", "SELL", stop=sl_price, limit=tp_price)
    bear_break_active := false
    traded_today      := true

// ─── VIZUALIZARE ──────────────────────────────────────────────────────────────
plotshape(bull_signal, "BUY Signal",  shape.labelup,   location.belowbar, color.green, text="B&B BUY",  size=size.small)
plotshape(bear_signal, "SELL Signal", shape.labeldown, location.abovebar, color.red,   text="B&B SELL", size=size.small)

bgcolor(bull_break_active ? color.new(color.green, 92) : na)
bgcolor(bear_break_active ? color.new(color.red,   92) : na)
bgcolor(not na(ny_session) ? color.new(color.yellow, 93) : na, title="NY Session")

// ─── ALERTE ───────────────────────────────────────────────────────────────────
alertcondition(bull_signal, "B&B BUY",  "Break & Bounce BUY - Retest confirmat bullish")
alertcondition(bear_signal, "B&B SELL", "Break & Bounce SELL - Retest confirmat bearish")
