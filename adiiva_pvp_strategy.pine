//@version=5
strategy("Adiiva PVP Strategy", overlay=true, max_bars_back=1000,
         process_orders_on_close=false,
         default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         commission_type=strategy.commission.percent, commission_value=0.05)

// ================================================================================
// INPUTS
// ================================================================================
i_num_rows = input.int(500,  "Number of Rows", minval=10, maxval=2000, group="Volume Profile (PVP)")
i_va_pct   = input.float(68.0, "Value Area %", minval=1, maxval=100,  group="Volume Profile (PVP)") / 100.0
i_rr       = input.float(1.5,  "RR Ratio",     minval=0.1, step=0.1,  group="Strategy")

i_col_sess = input.color(color.new(color.blue,   88), "Trading Session BG",  group="Visual")
i_col_vah  = input.color(color.new(color.lime,    0), "VAH",                 group="Visual")
i_col_val  = input.color(color.new(color.red,     0), "VAL",                 group="Visual")
i_col_poc  = input.color(color.new(color.orange,  0), "POC",                 group="Visual")
i_col_vwap = input.color(color.new(color.white,   0), "VWAP (Session)",      group="Visual")
i_col_nyhl = input.color(color.new(color.orange,  0), "NY Day H/L (prev)",   group="Visual")
i_col_4hhl = input.color(color.new(color.teal,    0), "NY 4H H/L (prev)",    group="Visual")

TZ = "Europe/Bucharest"

// ================================================================================
// VWAP - Session anchor, Source: HLC3
// Identic cu TradingView built-in VWAP: Anchor=Session, Source=(H+L+C)/3
// Singura linie dinamica (curba) din strategie
// ================================================================================
session_vwap = ta.vwap(hlc3)

// ================================================================================
// SESSION FLAGS
// ================================================================================
is_pvp   = not na(time(timeframe.period, "1200-1600", TZ))
is_trade = not na(time(timeframe.period, "1600-2200", TZ))
is_entry = not na(time(timeframe.period, "1600-1900", TZ))
is_ny4h  = not na(time(timeframe.period, "0700-1100", TZ))

pvp_started  = is_pvp  and not is_pvp[1]
pvp_ended    = not is_pvp  and is_pvp[1]
trade_ended  = not is_trade and is_trade[1]
ny4h_started = is_ny4h and not is_ny4h[1]
ny4h_ended   = not is_ny4h and is_ny4h[1]

// ================================================================================
// VOLUME PROFILE - sesiunea PVP 12:00-16:00 RO
// Number of Rows = 500 (identic cu TradingView PVP)
// Pret per rand = (session_high - session_low) / 500
// ================================================================================
var float[] _bh = array.new_float(0)
var float[] _bl = array.new_float(0)
var float[] _bv = array.new_float(0)
var float   vah   = na
var float   val_l = na
var float   poc_  = na
var float   _wpsum = 0.0
var float   _vsum  = 0.0

if pvp_started
    array.clear(_bh)
    array.clear(_bl)
    array.clear(_bv)
    _wpsum := 0.0
    _vsum  := 0.0

if is_pvp
    array.push(_bh, high)
    array.push(_bl, low)
    array.push(_bv, volume)
    _wpsum += hlc3 * volume
    _vsum  += volume

if pvp_ended and _vsum > 0.0
    n    = array.size(_bh)
    s_hi = array.max(_bh)
    s_lo = array.min(_bl)
    rng  = s_hi - s_lo
    nr     = i_num_rows
    row_px = rng / float(nr)
    if row_px > 0.0
        rv = array.new_float(nr, 0.0)
        for i = 0 to n - 1
            bh_ = array.get(_bh, i)
            bl_ = array.get(_bl, i)
            bv_ = array.get(_bv, i)
            ri0 = int(math.max(0.0,           math.floor((bl_ - s_lo) / row_px)))
            ri1 = int(math.min(float(nr - 1), math.floor((bh_ - s_lo) / row_px)))
            sp  = ri1 - ri0 + 1
            if sp > 0
                vpr = bv_ / float(sp)
                for r = ri0 to ri1
                    array.set(rv, r, array.get(rv, r) + vpr)
        poc_idx = 0
        maxv    = 0.0
        for r = 0 to nr - 1
            v = array.get(rv, r)
            if v > maxv
                maxv    := v
                poc_idx := r
        poc_ := s_lo + (float(poc_idx) + 0.5) * row_px
        totv = array.sum(rv)
        tgtv = totv * i_va_pct
        accv = maxv
        lo_i = poc_idx
        hi_i = poc_idx
        while accv < tgtv
            cdn = lo_i > 0
            cup = hi_i < nr - 1
            if not cdn and not cup
                break
            if cdn and cup
                dv = array.get(rv, lo_i - 1)
                uv = array.get(rv, hi_i + 1)
                if dv >= uv
                    lo_i -= 1
                    accv += dv
                else
                    hi_i += 1
                    accv += uv
            else if cdn
                lo_i -= 1
                accv += array.get(rv, lo_i)
            else
                hi_i += 1
                accv += array.get(rv, hi_i)
        val_l := s_lo + float(lo_i) * row_px
        vah   := s_lo + float(hi_i + 1) * row_px

// ================================================================================
// HIGH / LOW LEVELS
// ================================================================================
var line ln_4hh = na
var line ln_4hl = na
var line ln_nyh = na
var line ln_nyl = na

var float ny_cal_h   = na
var float ny_cal_l   = na
var float ny4h_h     = na
var float ny4h_l     = na
var float prev_ny_h  = na
var float prev_ny_l  = na
var float prev_4h_h  = na
var float prev_4h_l  = na



// NY calendar day: 00:00-24:00 NY = 07:00-07:00 RO, resetat la ny4h_started
if ny4h_started
    prev_ny_h  := ny_cal_h
    prev_ny_l  := ny_cal_l
    line.delete(ln_nyh)
    line.delete(ln_nyl)
    xny = bar_index
    ln_nyh := not na(prev_ny_h) ? line.new(xny, prev_ny_h, xny + 1, prev_ny_h, extend=extend.right, color=i_col_nyhl, width=1, style=line.style_solid) : na
    ln_nyl := not na(prev_ny_l) ? line.new(xny, prev_ny_l, xny + 1, prev_ny_l, extend=extend.right, color=i_col_nyhl, width=1, style=line.style_solid) : na
    if not na(prev_ny_h)
        label.new(xny, prev_ny_h, "NY.H", style=label.style_none, textcolor=i_col_nyhl, size=size.small)
    if not na(prev_ny_l)
        label.new(xny, prev_ny_l, "NY.L", style=label.style_none, textcolor=i_col_nyhl, size=size.small)
    ny_cal_h := high
    ny_cal_l := low
    ny4h_h := high
    ny4h_l := low
ny_cal_h := math.max(ny_cal_h, high)
ny_cal_l := math.min(ny_cal_l, low)

if is_ny4h
    ny4h_h := math.max(ny4h_h, high)
    ny4h_l := math.min(ny4h_l, low)
if ny4h_ended
    prev_4h_h := ny4h_h
    prev_4h_l := ny4h_l
    line.delete(ln_4hh)
    line.delete(ln_4hl)
    x4h = bar_index
    ln_4hh := not na(prev_4h_h) ? line.new(x4h, prev_4h_h, x4h + 1, prev_4h_h, extend=extend.right, color=i_col_4hhl, width=1, style=line.style_dashed) : na
    ln_4hl := not na(prev_4h_l) ? line.new(x4h, prev_4h_l, x4h + 1, prev_4h_l, extend=extend.right, color=i_col_4hhl, width=1, style=line.style_dashed) : na
    if not na(prev_4h_h)
        label.new(x4h, prev_4h_h, "4H.H", style=label.style_none, textcolor=i_col_4hhl, size=size.small)
    if not na(prev_4h_l)
        label.new(x4h, prev_4h_l, "4H.L", style=label.style_none, textcolor=i_col_4hhl, size=size.small)

// ================================================================================
// MSS DETECTION
//
// Valid HIGH = urmat de minim 2 lumanari bearish consecutive
// Valid LOW  = urmat de minim 2 lumanari bullish consecutive
//
// SL pentru LONG  = low-ul celor 2 lumanari bearish care au format pullback-ul
//                   (ultimul low inainte de BULL MSS)
// SL pentru SHORT = high-ul celor 2 lumanari bullish care au format pullback-ul
//                   (ultimul high inainte de BEAR MSS)
// ================================================================================
bear_seq = (close < open) and (close[1] < open[1])
bull_seq = (close > open) and (close[1] > open[1])

var float tracked_sh     = na
var float tracked_sl     = na
var float bear_seq_sl    = na
var float bull_seq_sh    = na
var float bull_mss_lvl   = na  // swing high spart → nivel retest LONG
var float bear_mss_lvl   = na  // swing low spart → nivel retest SHORT
var float last_bear_low  = na  // low-ul intregii secvente bearish curente
var float last_bull_high = na  // high-ul intregii secvente bullish curente
var int   last_mss_dir   = 0   // 0=niciuna, 1=bull MSS, -1=bear MSS (alternare)

bear_seq_start = bear_seq and not bear_seq[1]
bull_seq_start = bull_seq and not bull_seq[1]

if bear_seq_start
    if not na(last_bull_high)
        tracked_sh := math.max(last_bull_high, high[0], high[1])
    last_bull_high := na
    last_bear_low  := na(last_bear_low) ? math.min(low[0], low[1]) : math.min(last_bear_low, low[0], low[1])
    new_sl         = math.min(low[0], low[1])
    bear_seq_sl   := na(bear_seq_sl) ? new_sl : math.min(bear_seq_sl, new_sl)
else if bear_seq
    last_bear_low := na(last_bear_low) ? low[0] : math.min(last_bear_low, low[0])
    bear_seq_sl   := na(bear_seq_sl) ? low[0] : math.min(bear_seq_sl, low[0])

if bull_seq_start
    if not na(last_bear_low)
        tracked_sl := math.min(last_bear_low, low[0], low[1])
    last_bear_low  := na
    last_bull_high := na(last_bull_high) ? math.max(high[0], high[1]) : math.max(last_bull_high, high[0], high[1])
    new_sh         = math.max(high[0], high[1])
    bull_seq_sh   := na(bull_seq_sh) ? new_sh : math.max(bull_seq_sh, new_sh)
else if bull_seq
    last_bull_high := na(last_bull_high) ? high[0] : math.max(last_bull_high, high[0])
    bull_seq_sh    := na(bull_seq_sh) ? high[0] : math.max(bull_seq_sh, high[0])

bull_mss = not na(tracked_sh) and close > tracked_sh and close[1] <= tracked_sh and not bear_seq_start
bear_mss = not na(tracked_sl) and close < tracked_sl and close[1] >= tracked_sl and not bull_seq_start

bull_mss_sl = bear_seq_sl
bear_mss_sl = bull_seq_sh

if bull_mss
    bull_mss_lvl  := tracked_sh
    tracked_sh    := na
    tracked_sl    := na
    bear_seq_sl   := na
    bull_seq_sh   := na
    last_bear_low  := na
    last_bull_high := na
    last_mss_dir   := 1
if bear_mss
    bear_mss_lvl  := tracked_sl
    tracked_sl    := na
    tracked_sh    := na
    bull_seq_sh   := na
    bear_seq_sl   := na
    last_bull_high := na
    last_bear_low  := na
    last_mss_dir   := -1

// ================================================================================
// STRATEGY LOGIC
// Setup  LONG  : pret > VAH  SI pret > VWAP (session) + MSS bullish → asteapta retest
// Setup  SHORT : pret < VAL  SI pret < VWAP (session) + MSS bearish → asteapta retest
// Retest: pret atinge nivelul spart (max 4 candele), altfel anulat
// Anulat daca pretul urca/coboara 1R in directia favorabila fara retest
// ================================================================================
var int   trades_today  = 0
var bool  last_was_sl   = false
var bool  waiting_long  = false
var bool  waiting_short = false
var int   setup_bar_l   = -1
var int   setup_bar_s   = -1
var float retest_lvl_l  = na
var float retest_lvl_s  = na
var float sl_long       = na
var float sl_short      = na

if pvp_started
    trades_today   := 0
    last_was_sl    := false
    waiting_long   := false
    waiting_short  := false
    tracked_sh     := na
    tracked_sl     := na
    bear_seq_sl    := na
    bull_seq_sh    := na
    last_bear_low  := na
    last_bull_high := na
    last_mss_dir   := 0

if trade_ended
    waiting_long  := false
    waiting_short := false

if strategy.closedtrades > strategy.closedtrades[1]
    last_was_sl := strategy.closedtrades.profit(strategy.closedtrades - 1) < 0.0

trade_limit_ok = trades_today < 2 and (trades_today == 0 or (trades_today == 1 and last_was_sl))
can_enter      = is_entry and strategy.opentrades == 0 and trade_limit_ok

long_setup  = can_enter and not na(vah) and close > vah and close > session_vwap and bull_mss
short_setup = can_enter and not na(val_l) and close < val_l and close < session_vwap and bear_mss

if long_setup and not waiting_short
    if not waiting_long
        waiting_long   := true
        setup_bar_l    := bar_index
    retest_lvl_l   := bull_mss_lvl
    sl_long        := na(bull_mss_sl) ? math.min(low[1], low[2]) : bull_mss_sl

if short_setup and not waiting_long
    if not waiting_short
        waiting_short  := true
        setup_bar_s    := bar_index
    retest_lvl_s   := bear_mss_lvl
    sl_short       := na(bear_mss_sl) ? math.max(high[1], high[2]) : bear_mss_sl

if waiting_long  and bear_mss and not na(vah)   and close < vah
    waiting_long  := false
if waiting_short and bull_mss and not na(val_l) and close > val_l
    waiting_short := false

bars_l = bar_index - setup_bar_l
bars_s = bar_index - setup_bar_s

if waiting_long and bars_l >= 1
    _sl_dist_l = math.max(retest_lvl_l - sl_long, syminfo.mintick * 10)
    if bars_l > 4 or high >= retest_lvl_l + _sl_dist_l or not is_entry
        waiting_long := false

if waiting_short and bars_s >= 1
    _sl_dist_s = math.max(sl_short - retest_lvl_s, syminfo.mintick * 10)
    if bars_s > 4 or low <= retest_lvl_s - _sl_dist_s or not is_entry
        waiting_short := false

// Limit activ pe fiecare bara cat timp asteptam retest
// Cu process_orders_on_close=false, ordinul pus pe bara N se umple la bara N+1 → prima bara dupa MSS
if waiting_long and strategy.opentrades == 0 and is_entry
    strategy.entry("LONG",  strategy.long,  limit=retest_lvl_l)
else
    strategy.cancel("LONG")

if waiting_short and strategy.opentrades == 0 and is_entry
    strategy.entry("SHORT", strategy.short, limit=retest_lvl_s)
else
    strategy.cancel("SHORT")

// Exit pus separat, doar cand pozitia e deja deschisa (evita SL hit same-bar cu entry)
if strategy.position_size > 0 and not na(sl_long) and not na(retest_lvl_l)
    sl_dist_l = math.max(retest_lvl_l - sl_long, syminfo.mintick * 10)
    strategy.exit("LONG_X",  "LONG",  stop=sl_long,  limit=retest_lvl_l + sl_dist_l * i_rr)
if strategy.position_size < 0 and not na(sl_short) and not na(retest_lvl_s)
    sl_dist_s = math.max(sl_short - retest_lvl_s, syminfo.mintick * 10)
    strategy.exit("SHORT_X", "SHORT", stop=sl_short, limit=retest_lvl_s - sl_dist_s * i_rr)

// Detectez umplerea ordinului
if strategy.opentrades > 0 and strategy.opentrades[1] == 0
    if waiting_long
        trades_today += 1
        waiting_long  := false
    else if waiting_short
        trades_today += 1
        waiting_short := false

long_fill  = strategy.opentrades > strategy.opentrades[1] and strategy.position_size > 0
short_fill = strategy.opentrades > strategy.opentrades[1] and strategy.position_size < 0

if trade_ended
    strategy.close_all("EOD")

// ================================================================================
// LINII FIXE - sterse si recreate la pvp_ended (16:00)
// Liniile de ieri raman vizibile toata sesiunea PVP (12:00-16:00)
// VWAP nu este linie fixa - este plot() dinamic (curba)
// ================================================================================
var line ln_vah = na
var line ln_val = na
var line ln_poc = na

if pvp_ended
    line.delete(ln_vah)
    line.delete(ln_val)
    line.delete(ln_poc)
    ln_vah := na
    ln_val := na
    ln_poc := na
    x = bar_index
    if not na(vah)
        ln_vah := line.new(x, vah,   x + 1, vah,   extend=extend.right, color=i_col_vah, width=2, style=line.style_solid)
        label.new(x, vah,   "VAH", style=label.style_none, textcolor=i_col_vah,  size=size.small)
    if not na(val_l)
        ln_val := line.new(x, val_l, x + 1, val_l, extend=extend.right, color=i_col_val, width=2, style=line.style_solid)
        label.new(x, val_l, "VAL", style=label.style_none, textcolor=i_col_val,  size=size.small)
    if not na(poc_)
        ln_poc := line.new(x, poc_,  x + 1, poc_,  extend=extend.right, color=i_col_poc, width=1, style=line.style_dashed)
        label.new(x, poc_,  "POC", style=label.style_none, textcolor=i_col_poc,  size=size.small)

// ================================================================================
// PLOTS
// VWAP = singura linie dinamica (curba), identic cu TV built-in VWAP Session
// ================================================================================
bgcolor(is_trade ? i_col_sess : na, title="Sesiune Trading")

plot(session_vwap, "VWAP", color=i_col_vwap, linewidth=2)

plot(waiting_long  ? retest_lvl_l : na, "Retest Level L", color=color.yellow, linewidth=1, style=plot.style_circles)
plot(waiting_short ? retest_lvl_s : na, "Retest Level S", color=color.yellow, linewidth=1, style=plot.style_circles)

// SL si TP vizibile pe grafic: apar cat timp asteptam retest SAU cat timp e pozitie deschisa
_show_l  = waiting_long  or strategy.position_size > 0
_show_s  = waiting_short or strategy.position_size < 0
_tp_l    = not na(retest_lvl_l) and not na(sl_long)  ? retest_lvl_l + math.max(retest_lvl_l - sl_long,  syminfo.mintick*10) * i_rr : na
_tp_s    = not na(retest_lvl_s) and not na(sl_short) ? retest_lvl_s - math.max(sl_short - retest_lvl_s, syminfo.mintick*10) * i_rr : na

plot(_show_l ? sl_long  : na, "SL Long",  color=color.red,                   linewidth=1, style=plot.style_linebr)
plot(_show_s ? sl_short : na, "SL Short", color=color.red,                   linewidth=1, style=plot.style_linebr)
plot(_show_l ? _tp_l    : na, "TP Long",  color=color.new(color.green,  30), linewidth=1, style=plot.style_linebr)
plot(_show_s ? _tp_s    : na, "TP Short", color=color.new(color.green,  30), linewidth=1, style=plot.style_linebr)

plot(strategy.opentrades, "Open Trades (debug)", color=color.orange, display=display.data_window)
plot(tracked_sl, "tracked_sl → BEAR MSS nivel", color=color.new(color.aqua,   50), linewidth=1, style=plot.style_stepline)
plot(tracked_sh, "tracked_sh → BULL MSS nivel", color=color.new(color.purple, 50), linewidth=1, style=plot.style_stepline)

plotshape(bull_mss,  "MSS Bullish",  shape.triangleup,   location.belowbar, color.lime,    size=size.tiny,   text="MSS^")
plotshape(bear_mss,  "MSS Bearish",  shape.triangledown, location.abovebar, color.fuchsia, size=size.tiny,   text="MSSv")
plotshape(long_fill,  "LONG Signal",  shape.labelup,      location.belowbar, color.green,   size=size.normal, text="LONG",  textcolor=color.white)
plotshape(short_fill, "SHORT Signal", shape.labeldown,    location.abovebar, color.red,     size=size.normal, text="SHORT", textcolor=color.white)
plotshape(long_fill,  "Retest LONG",  shape.circle, location.belowbar, color.new(color.lime,   40), size=size.tiny, text="R")
plotshape(short_fill, "Retest SHORT", shape.circle, location.abovebar, color.new(color.red,    40), size=size.tiny, text="R")


alertcondition(long_fill,  "LONG",  "Adiiva: LONG - deasupra VAH & VWAP | Bullish MSS")
alertcondition(short_fill, "SHORT", "Adiiva: SHORT - sub VAL & VWAP | Bearish MSS")
