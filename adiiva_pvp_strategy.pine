//@version=5
strategy("Adiiva PVP Strategy", overlay=true, max_bars_back=1000,
         process_orders_on_close=true,
         default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         commission_type=strategy.commission.percent, commission_value=0.05)

// ================================================================================
// INPUTS
// ================================================================================
i_num_rows = input.int(500,  "Number of Rows", minval=10, maxval=2000, group="Volume Profile (PVP)")
i_va_pct   = input.float(68.0, "Value Area %", minval=1, maxval=100,  group="Volume Profile (PVP)") / 100.0
i_rr       = input.float(1.5,  "RR Ratio",     minval=0.1, step=0.1,  group="Strategy")

i_col_sess = input.color(color.new(color.blue,   88), "Trading Session BG",  group="Visual")
i_col_vah  = input.color(color.new(color.lime,    0), "VAH",                 group="Visual")
i_col_val  = input.color(color.new(color.red,     0), "VAL",                 group="Visual")
i_col_poc  = input.color(color.new(color.orange,  0), "POC",                 group="Visual")
i_col_vwap = input.color(color.new(color.white,   0), "VWAP (Session)",      group="Visual")
i_col_dhl  = input.color(color.new(color.blue,    0), "Day H/L",             group="Visual")
i_col_nyhl = input.color(color.new(color.orange,  0), "NY Day H/L (prev)",   group="Visual")
i_col_4hhl = input.color(color.new(color.teal,    0), "NY 4H H/L (prev)",    group="Visual")

TZ = "Europe/Bucharest"

// ================================================================================
// VWAP - Session anchor, Source: HLC3
// Identic cu TradingView built-in VWAP: Anchor=Session, Source=(H+L+C)/3
// Singura linie dinamica (curba) din strategie
// ================================================================================
session_vwap = ta.vwap(hlc3)

// ================================================================================
// SESSION FLAGS
// ================================================================================
is_pvp   = not na(time(timeframe.period, "1200-1600", TZ))
is_trade = not na(time(timeframe.period, "1600-2200", TZ))
is_entry = not na(time(timeframe.period, "1600-1900", TZ))
is_ny4h  = not na(time(timeframe.period, "0700-1100", TZ))

pvp_started  = is_pvp  and not is_pvp[1]
pvp_ended    = not is_pvp  and is_pvp[1]
trade_ended  = not is_trade and is_trade[1]
ny4h_started = is_ny4h and not is_ny4h[1]
ny4h_ended   = not is_ny4h and is_ny4h[1]

// ================================================================================
// VOLUME PROFILE - sesiunea PVP 12:00-16:00 RO
// Number of Rows = 500 (identic cu TradingView PVP)
// Pret per rand = (session_high - session_low) / 500
// ================================================================================
var float[] _bh = array.new_float(0)
var float[] _bl = array.new_float(0)
var float[] _bv = array.new_float(0)
var float   vah   = na
var float   val_l = na
var float   poc_  = na
var float   _wpsum = 0.0
var float   _vsum  = 0.0

if pvp_started
    array.clear(_bh)
    array.clear(_bl)
    array.clear(_bv)
    _wpsum := 0.0
    _vsum  := 0.0

if is_pvp
    array.push(_bh, high)
    array.push(_bl, low)
    array.push(_bv, volume)
    _wpsum += hlc3 * volume
    _vsum  += volume

if pvp_ended and _vsum > 0.0
    n    = array.size(_bh)
    s_hi = array.max(_bh)
    s_lo = array.min(_bl)
    rng  = s_hi - s_lo
    nr     = i_num_rows
    row_px = rng / float(nr)
    if row_px > 0.0
        rv = array.new_float(nr, 0.0)
        for i = 0 to n - 1
            bh_ = array.get(_bh, i)
            bl_ = array.get(_bl, i)
            bv_ = array.get(_bv, i)
            ri0 = int(math.max(0.0,           math.floor((bl_ - s_lo) / row_px)))
            ri1 = int(math.min(float(nr - 1), math.floor((bh_ - s_lo) / row_px)))
            sp  = ri1 - ri0 + 1
            if sp > 0
                vpr = bv_ / float(sp)
                for r = ri0 to ri1
                    array.set(rv, r, array.get(rv, r) + vpr)
        poc_idx = 0
        maxv    = 0.0
        for r = 0 to nr - 1
            v = array.get(rv, r)
            if v > maxv
                maxv    := v
                poc_idx := r
        poc_ := s_lo + (float(poc_idx) + 0.5) * row_px
        totv = array.sum(rv)
        tgtv = totv * i_va_pct
        accv = maxv
        lo_i = poc_idx
        hi_i = poc_idx
        while accv < tgtv
            cdn = lo_i > 0
            cup = hi_i < nr - 1
            if not cdn and not cup
                break
            if cdn and cup
                dv = array.get(rv, lo_i - 1)
                uv = array.get(rv, hi_i + 1)
                if dv >= uv
                    lo_i -= 1
                    accv += dv
                else
                    hi_i += 1
                    accv += uv
            else if cdn
                lo_i -= 1
                accv += array.get(rv, lo_i)
            else
                hi_i += 1
                accv += array.get(rv, hi_i)
        val_l := s_lo + float(lo_i) * row_px
        vah   := s_lo + float(hi_i + 1) * row_px

// ================================================================================
// HIGH / LOW LEVELS
// ================================================================================
var line ln_4hh = na
var line ln_4hl = na
var line ln_dh  = na
var line ln_dl  = na
var line ln_nyh = na
var line ln_nyl = na

var float day_h      = na
var float day_l      = na
var float prev_day_h = na
var float prev_day_l = na
var float ny_cal_h   = na
var float ny_cal_l   = na
var float ny4h_h     = na
var float ny4h_l     = na
var float prev_ny_h  = na
var float prev_ny_l  = na
var float prev_4h_h  = na
var float prev_4h_l  = na

new_day = dayofmonth != dayofmonth[1]
if new_day
    prev_day_h := day_h
    prev_day_l := day_l
    line.delete(ln_dh)
    line.delete(ln_dl)
    xd = bar_index
    ln_dh := not na(prev_day_h) ? line.new(xd, prev_day_h, xd + 1, prev_day_h, extend=extend.right, color=i_col_dhl, width=1, style=line.style_solid) : na
    ln_dl := not na(prev_day_l) ? line.new(xd, prev_day_l, xd + 1, prev_day_l, extend=extend.right, color=i_col_dhl, width=1, style=line.style_solid) : na
    day_h := high
    day_l := low
if bar_index == 0
    day_h := high
    day_l := low
day_h := math.max(day_h, high)
day_l := math.min(day_l, low)

// NY calendar day: 00:00-24:00 NY = 07:00-07:00 RO, resetat la ny4h_started
if ny4h_started
    prev_ny_h  := ny_cal_h
    prev_ny_l  := ny_cal_l
    line.delete(ln_nyh)
    line.delete(ln_nyl)
    xny = bar_index
    ln_nyh := not na(prev_ny_h) ? line.new(xny, prev_ny_h, xny + 1, prev_ny_h, extend=extend.right, color=i_col_nyhl, width=1, style=line.style_solid) : na
    ln_nyl := not na(prev_ny_l) ? line.new(xny, prev_ny_l, xny + 1, prev_ny_l, extend=extend.right, color=i_col_nyhl, width=1, style=line.style_solid) : na
    ny_cal_h := high
    ny_cal_l := low
    ny4h_h := high
    ny4h_l := low
ny_cal_h := math.max(ny_cal_h, high)
ny_cal_l := math.min(ny_cal_l, low)

if is_ny4h
    ny4h_h := math.max(ny4h_h, high)
    ny4h_l := math.min(ny4h_l, low)
if ny4h_ended
    prev_4h_h := ny4h_h
    prev_4h_l := ny4h_l
    line.delete(ln_4hh)
    line.delete(ln_4hl)
    x4h = bar_index
    ln_4hh := not na(prev_4h_h) ? line.new(x4h, prev_4h_h, x4h + 1, prev_4h_h, extend=extend.right, color=i_col_4hhl, width=1, style=line.style_dashed) : na
    ln_4hl := not na(prev_4h_l) ? line.new(x4h, prev_4h_l, x4h + 1, prev_4h_l, extend=extend.right, color=i_col_4hhl, width=1, style=line.style_dashed) : na

// ================================================================================
// MSS DETECTION
//
// Valid HIGH = urmat de minim 2 lumanari bearish consecutive
// Valid LOW  = urmat de minim 2 lumanari bullish consecutive
//
// SL pentru LONG  = low-ul celor 2 lumanari bearish care au format pullback-ul
//                   (ultimul low inainte de BULL MSS)
// SL pentru SHORT = high-ul celor 2 lumanari bullish care au format pullback-ul
//                   (ultimul high inainte de BEAR MSS)
// ================================================================================
bear_seq = (close < open) and (close[1] < open[1])
bull_seq = (close > open) and (close[1] > open[1])

var float tracked_sh  = na
var float tracked_sl  = na
var float bear_seq_sl = na  // low pullback bearish → SL pentru LONG
var float bull_seq_sh = na  // high pullback bullish → SL pentru SHORT

if bear_seq
    tracked_sh  := math.max(high[2], high[3])
    bear_seq_sl := math.min(low[0], low[1])
if bull_seq
    tracked_sl  := math.min(low[2], low[3])
    bull_seq_sh := math.max(high[0], high[1])

bull_mss = not na(tracked_sh) and close > tracked_sh and close[1] <= tracked_sh
bear_mss = not na(tracked_sl) and close < tracked_sl and close[1] >= tracked_sl

bull_mss_sl = bear_seq_sl
bear_mss_sl = bull_seq_sh

if bull_mss
    tracked_sh  := na
    bear_seq_sl := na
if bear_mss
    tracked_sl  := na
    bull_seq_sh := na

// ================================================================================
// STRATEGY LOGIC
// Conditie LONG  : pret > VAH  SI pret > VWAP (session) + MSS bullish
// Conditie SHORT : pret < VAL  SI pret < VWAP (session) + MSS bearish
// ================================================================================
var int  trades_today = 0
var bool last_was_sl  = false

if pvp_started
    trades_today := 0
    last_was_sl  := false

if strategy.closedtrades > strategy.closedtrades[1]
    last_was_sl := strategy.closedtrades.profit(strategy.closedtrades - 1) < 0.0

trade_limit_ok = trades_today < 2 and (trades_today == 0 or (trades_today == 1 and last_was_sl))
can_enter      = is_entry and strategy.opentrades == 0 and trade_limit_ok
long_ok        = can_enter and not na(vah) and close > vah and close > session_vwap and bull_mss
short_ok       = can_enter and not na(val_l) and close < val_l and close < session_vwap and bear_mss

if long_ok
    sl_price = na(bull_mss_sl) ? math.min(low[1], low[2]) : bull_mss_sl
    sl_dist  = math.max(close - sl_price, syminfo.mintick * 10)
    strategy.entry("LONG", strategy.long)
    strategy.exit("LONG_X", "LONG", stop=sl_price, limit=close + sl_dist * i_rr)
    trades_today += 1
    tracked_sl  := na
    bear_seq_sl := na

if short_ok
    sl_price = na(bear_mss_sl) ? math.max(high[1], high[2]) : bear_mss_sl
    sl_dist  = math.max(sl_price - close, syminfo.mintick * 10)
    strategy.entry("SHORT", strategy.short)
    strategy.exit("SHORT_X", "SHORT", stop=sl_price, limit=close - sl_dist * i_rr)
    trades_today += 1
    tracked_sh  := na
    bull_seq_sh := na

if trade_ended
    strategy.close_all("EOD")

// ================================================================================
// LINII FIXE - sterse si recreate la pvp_ended (16:00)
// Liniile de ieri raman vizibile toata sesiunea PVP (12:00-16:00)
// VWAP nu este linie fixa - este plot() dinamic (curba)
// ================================================================================
var line ln_vah = na
var line ln_val = na
var line ln_poc = na

if pvp_ended
    line.delete(ln_vah)
    line.delete(ln_val)
    line.delete(ln_poc)
    ln_vah := na
    ln_val := na
    ln_poc := na
    x = bar_index
    if not na(vah)
        ln_vah := line.new(x, vah,   x + 1, vah,   extend=extend.right, color=i_col_vah, width=2, style=line.style_solid)
    if not na(val_l)
        ln_val := line.new(x, val_l, x + 1, val_l, extend=extend.right, color=i_col_val, width=2, style=line.style_solid)
    if not na(poc_)
        ln_poc := line.new(x, poc_,  x + 1, poc_,  extend=extend.right, color=i_col_poc, width=1, style=line.style_dashed)

// ================================================================================
// PLOTS
// VWAP = singura linie dinamica (curba), identic cu TV built-in VWAP Session
// ================================================================================
bgcolor(is_trade ? i_col_sess : na, title="Sesiune Trading")

plot(session_vwap, "VWAP", color=i_col_vwap, linewidth=2)

plotshape(bull_mss,  "MSS Bullish",  shape.triangleup,   location.belowbar, color.lime,    size=size.tiny,   text="MSS^")
plotshape(bear_mss,  "MSS Bearish",  shape.triangledown, location.abovebar, color.fuchsia, size=size.tiny,   text="MSSv")
plotshape(long_ok,   "LONG Signal",  shape.labelup,      location.belowbar, color.green,   size=size.normal, text="LONG",  textcolor=color.white)
plotshape(short_ok,  "SHORT Signal", shape.labeldown,    location.abovebar, color.red,     size=size.normal, text="SHORT", textcolor=color.white)

// ================================================================================
// ETICHETE INLINE la ora 18:00
// VAH  = Value Area High       | VAL  = Value Area Low
// POC  = Point of Control
// D.H  = Daily High (la 16:00) | D.L  = Daily Low (la 16:00)
// NY.H = NY High ziua PREV     | NY.L = NY Low ziua PREV
// 4H.H = Prima 4H NY High PREV | 4H.L = Prima 4H NY Low PREV
// ================================================================================
var bool lbl_drawn = false
if pvp_started
    lbl_drawn := false

if is_trade and not lbl_drawn and hour(time, TZ) >= 18
    lbl_drawn := true
    if not na(vah)
        label.new(bar_index, vah,       "VAH",  style=label.style_none, textcolor=i_col_vah,  size=size.small)
    if not na(val_l)
        label.new(bar_index, val_l,     "VAL",  style=label.style_none, textcolor=i_col_val,  size=size.small)
    if not na(poc_)
        label.new(bar_index, poc_,      "POC",  style=label.style_none, textcolor=i_col_poc,  size=size.small)
    if not na(prev_day_h)
        label.new(bar_index, prev_day_h, "D.H", style=label.style_none, textcolor=i_col_dhl,  size=size.small)
    if not na(prev_day_l)
        label.new(bar_index, prev_day_l, "D.L", style=label.style_none, textcolor=i_col_dhl,  size=size.small)
    if not na(prev_ny_h)
        label.new(bar_index, prev_ny_h, "NY.H", style=label.style_none, textcolor=i_col_nyhl, size=size.small)
    if not na(prev_ny_l)
        label.new(bar_index, prev_ny_l, "NY.L", style=label.style_none, textcolor=i_col_nyhl, size=size.small)
    if not na(prev_4h_h)
        label.new(bar_index, prev_4h_h, "4H.H", style=label.style_none, textcolor=i_col_4hhl, size=size.small)
    if not na(prev_4h_l)
        label.new(bar_index, prev_4h_l, "4H.L", style=label.style_none, textcolor=i_col_4hhl, size=size.small)

alertcondition(long_ok,  "LONG",  "Adiiva: LONG - deasupra VAH & VWAP | Bullish MSS")
alertcondition(short_ok, "SHORT", "Adiiva: SHORT - sub VAL & VWAP | Bearish MSS")
